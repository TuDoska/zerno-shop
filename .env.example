# Скопіюй у .env (локально) або додай у Environment на Render
PORT=3000
NODE_ENV=development
# Довгий випадковий рядок (на Render генерується автоматично)
JWT_SECRET=change-me
# Рядок підключення MongoDB Atlas. Якщо порожній — дані зберігаються у файлах папки data/
MONGODB_URI=
MONGODB_DB=zerno
# Ім'я користувача, який автоматично стане адміністратором
ADMIN_USERNAME=
